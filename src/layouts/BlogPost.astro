---
const { frontmatter } = Astro.props;
const formattedDate = new Date(frontmatter.date).toLocaleDateString('de-DE', {
  day: '2-digit', month: 'long', year: 'numeric'
});
---
<!doctype html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{frontmatter.title} — Holocron</title>
<meta name="description" content={frontmatter.excerpt}>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg viewBox='0 0 32 32' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='4' y='4' width='24' height='24' rx='4' fill='%2309090B'/%3E%3Cpath d='M16 10v12M10 16h12' stroke='white' stroke-width='2.5' stroke-linecap='round'/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #FFFFFF; --bg-muted: #FAFAFA; --fg: #09090B; --fg-muted: #71717A; --fg-light: #A1A1AA;
  --border: #E4E4E7; --border-hover: #D4D4D8; --accent: #2563EB;
  --font: 'Inter', -apple-system, sans-serif; --font-mono: 'JetBrains Mono', monospace;
}
html { scroll-behavior: smooth; }
body { font-family: var(--font); background: var(--bg); color: var(--fg); line-height: 1.6; -webkit-font-smoothing: antialiased; }

/* NAV */
nav { position: fixed; top: 0; left: 0; right: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; height: 56px; background: rgba(255,255,255,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
.nav-left { display: flex; align-items: center; gap: 1.25rem; }
.logo { display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: var(--fg); }
.logo-mark { width: 24px; height: 24px; }
.logo-mark svg { width: 100%; height: 100%; display: block; }
.logo-text { font-weight: 700; font-size: 0.88rem; letter-spacing: -0.02em; }
.nav-items { display: flex; gap: 0; align-items: center; }
.nav-item > a { text-decoration: none; color: var(--fg-muted); font-size: 0.825rem; font-weight: 500; padding: 0.4rem 0.7rem; border-radius: 6px; transition: color 0.15s, background 0.15s; display: inline-flex; align-items: center; height: 32px; }
.nav-item > a:hover { color: var(--fg); background: var(--bg-muted); }
.nav-item > a.active { color: var(--fg); }
.nav-right { display: flex; align-items: center; gap: 0.5rem; }
.nav-cta { background: var(--fg); color: white; border: none; padding: 0.4rem 1rem; border-radius: 6px; font-family: var(--font); font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
.nav-cta:hover { opacity: 0.85; }

/* POST LAYOUT */
.post-page { padding-top: 56px; }

/* BACK + BREADCRUMB */
.post-nav { max-width: 720px; margin: 0 auto; padding: 2rem 1.5rem 0; }
.back-link { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--fg-muted); text-decoration: none; transition: color 0.15s; font-family: var(--font-mono); }
.back-link:hover { color: var(--fg); }

/* POST HEADER */
.post-header { max-width: 720px; margin: 0 auto; padding: 2.5rem 1.5rem 3rem; }
.post-tag { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: 1rem; }
.post-header h1 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1.2; margin-bottom: 1.25rem; }
.post-header .excerpt { font-size: 1.05rem; color: var(--fg-muted); line-height: 1.65; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
.post-meta-row { display: flex; align-items: center; gap: 1rem; font-size: 0.75rem; color: var(--fg-light); font-family: var(--font-mono); }
.post-meta-row .sep { opacity: 0.4; }

/* POST BODY */
.post-body { max-width: 720px; margin: 0 auto; padding: 0 1.5rem 4rem; }
.post-body :global(h2) { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.025em; margin: 2.5rem 0 0.85rem; line-height: 1.3; }
.post-body :global(h3) { font-size: 1.05rem; font-weight: 600; margin: 2rem 0 0.6rem; }
.post-body :global(p) { font-size: 0.95rem; color: #3F3F46; line-height: 1.8; margin-bottom: 1.25rem; }
.post-body :global(ul), .post-body :global(ol) { margin: 0 0 1.25rem 1.25rem; }
.post-body :global(li) { font-size: 0.95rem; color: #3F3F46; line-height: 1.75; margin-bottom: 0.4rem; }
.post-body :global(strong) { color: var(--fg); font-weight: 600; }
.post-body :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
.post-body :global(code) { font-family: var(--font-mono); font-size: 0.82rem; background: var(--bg-muted); border: 1px solid var(--border); padding: 0.15rem 0.4rem; border-radius: 4px; color: var(--fg); }
.post-body :global(pre) { background: var(--bg-muted); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; overflow-x: auto; margin-bottom: 1.5rem; }
.post-body :global(pre code) { background: none; border: none; padding: 0; }
.post-body :global(blockquote) { border-left: 3px solid var(--border); padding: 0.5rem 0 0.5rem 1.25rem; margin: 1.5rem 0; }
.post-body :global(blockquote p) { color: var(--fg-muted); font-style: italic; }
.post-body :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

/* DIVIDER */
.post-divider { max-width: 720px; margin: 0 auto; padding: 0 1.5rem; }
.post-divider hr { border: none; border-top: 1px solid var(--border); }

/* CTA BOX */
.post-cta { max-width: 720px; margin: 0 auto; padding: 0 1.5rem 4rem; }
.cta-box { background: var(--bg-muted); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
.cta-box h3 { font-size: 1rem; font-weight: 700; margin-bottom: 0.3rem; letter-spacing: -0.01em; }
.cta-box p { font-size: 0.84rem; color: var(--fg-muted); }
.btn-dark { background: var(--fg); color: white; padding: 0.6rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.84rem; transition: opacity 0.15s; white-space: nowrap; }
.btn-dark:hover { opacity: 0.85; }

/* FOOTER */
footer { border-top: 1px solid var(--border); padding: 2rem 1.5rem; display: flex; justify-content: space-between; align-items: center; max-width: 1100px; margin: 0 auto; font-size: 0.78rem; color: var(--fg-light); }

@media(max-width: 640px) { .nav-items { display: none; } .cta-box { flex-direction: column; align-items: flex-start; } footer { flex-direction: column; gap: 0.5rem; text-align: center; } }
</style>
</head>
<body>

<nav>
  <div class="nav-left">
    <a href="/" class="logo">
      <div class="logo-mark"><svg viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="4" fill="#09090B"/><path d="M12 7v10M7 12h10" stroke="white" stroke-width="2" stroke-linecap="round"/></svg></div>
      <span class="logo-text">Holocron</span>
    </a>
    <div class="nav-items">
      <div class="nav-item"><a href="/#services">Leistungen</a></div>
      <div class="nav-item"><a href="/#process">Ablauf</a></div>
      <div class="nav-item"><a href="/#pricing">Preise</a></div>
      <div class="nav-item"><a href="/#portfolio">Projekte</a></div>
      <div class="nav-item"><a href="/blog" class="active">Blog</a></div>
    </div>
  </div>
  <div class="nav-right">
    <a href="/#contact" class="nav-cta">Kontakt</a>
  </div>
</nav>

<div class="post-page">

  <div class="post-nav">
    <a href="/blog" class="back-link">← Blog</a>
  </div>

  <div class="post-header">
    <div class="post-tag">{frontmatter.tag || 'Blog'}</div>
    <h1>{frontmatter.title}</h1>
    <p class="excerpt">{frontmatter.excerpt}</p>
    <div class="post-meta-row">
      <span>{formattedDate}</span>
      {frontmatter.readTime && <><span class="sep">·</span><span>{frontmatter.readTime} min Lesezeit</span></>}
    </div>
  </div>

  <div class="post-divider"><hr></div>

  <div class="post-body">
    <slot />
  </div>

  <div class="post-cta">
    <div class="cta-box">
      <div>
        <h3>Bereit, Ihre Daten in Ordnung zu bringen?</h3>
        <p>Ich helfe mittelständischen Unternehmen, verlässliche BI-Strukturen aufzubauen.</p>
      </div>
      <a href="/#contact" class="btn-dark">Projekt anfragen →</a>
    </div>
  </div>

</div>

<footer>
  <span>© 2026 Holocron — holocrondata.net</span>
  <span>Business Intelligence Services</span>
</footer>

</body>
</html>
