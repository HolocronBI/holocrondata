---
import Base from "./Base.astro";
import { brand } from "../config/brand";
const { frontmatter } = Astro.props;
const date = new Date(frontmatter.date);
const formattedDate = date.toLocaleDateString("de-DE", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Base
  title={`${frontmatter.title} — ${brand.name}`}
  description={frontmatter.excerpt}
  article
>
  <article class="article-wrap">
    <header class="article-head">
      <a href="/blog/" class="back-link">← Alle Beiträge</a><p class="eyebrow">
        {frontmatter.tag || "Business Intelligence"}
      </p><h1>{frontmatter.title}</h1><p class="article-excerpt">
        {frontmatter.excerpt}
      </p><div class="post-meta">
        <time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time>{
          frontmatter.readTime && (
            <span>{frontmatter.readTime} Min. Lesezeit</span>
          )
        }
      </div>
    </header>
    <div class="article-body"><slot /></div>
  </article>
  <aside class="article-cta article-wrap">
    <div>
      <h2>Eine Frage zu Ihren Daten?</h2><p>
        Wir klären gemeinsam den passenden nächsten Schritt.
      </p>
    </div><a class="button" href="/#contact"
      >Projekt besprechen <span aria-hidden="true">↗</span></a>
  </aside>
</Base>
