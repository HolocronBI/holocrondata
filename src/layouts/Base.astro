---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'Holocron Data — BI & Datenanalyse für den Mittelstand',
  description = 'Freelance Business Intelligence Beratung: Datenmodellierung, Power BI Reports und Datenbereinigung für B2B Unternehmen.',
  lang = 'de'
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a href="/" class="nav-logo">holocron<span>.</span>data</a>
      <ul class="nav-links">
        <li><a href="/#leistungen" data-de="Leistungen" data-en="Services">Leistungen</a></li>
        <li><a href="/#ablauf" data-de="Ablauf" data-en="Process">Ablauf</a></li>
        <li><a href="/#preise" data-de="Preise" data-en="Pricing">Preise</a></li>
        <li><a href="/#projekte" data-de="Projekte" data-en="Projects">Projekte</a></li>
        <li><a href="/blog" data-de="Blog" data-en="Blog">Blog</a></li>
        <li>
          <button class="lang-btn" id="langToggle">EN</button>
        </li>
        <li>
          <a href="/#kontakt" class="nav-cta" data-de="Kontakt" data-en="Contact">Kontakt</a>
        </li>
      </ul>
    </div>
  </nav>

  <slot />

  <footer>
    <div class="container">
      <div class="footer-inner">
        <span>© 2025 Holocron Data. Alle Rechte vorbehalten.</span>
        <div class="footer-links">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Language toggle
    const langBtn = document.getElementById('langToggle');
    let lang = 'de';

    langBtn?.addEventListener('click', () => {
      lang = lang === 'de' ? 'en' : 'de';
      langBtn.textContent = lang === 'de' ? 'EN' : 'DE';
      document.querySelectorAll('[data-de]').forEach(el => {
        el.textContent = lang === 'de'
          ? el.getAttribute('data-de') || ''
          : el.getAttribute('data-en') || '';
      });
      document.querySelectorAll('[data-de-ph]').forEach(el => {
        (el as HTMLInputElement | HTMLTextAreaElement).placeholder = lang === 'de'
          ? el.getAttribute('data-de-ph') || ''
          : el.getAttribute('data-en-ph') || '';
      });
    });
  </script>
</body>
</html>
