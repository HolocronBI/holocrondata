---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand, brandLabel, legalReady, type Locale } from "../config/brand";
interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  home?: boolean;
  noindex?: boolean;
}
const {
  lang = "de",
  home = false,
  noindex = false,
} = Astro.props;
const title = Astro.props.title || brandLabel;
const description = Astro.props.description || brand.description[lang];
const canonical = new URL(Astro.url.pathname, brand.siteUrl);
const image = new URL(brand.socialImage, brand.siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F5F6F8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={brand.favicon} />
    <link
      rel="preload"
      href="/fonts/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      (noindex || !legalReady) && (
        <meta name="robots" content="noindex, nofollow" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandLabel} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={lang === "de"
        ? "Perlweiße Materialstudie mit Silber- und Glasdetails"
        : "Pearl-white material study with silver and glass details"}
    />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      home && (
        <>
          <link rel="alternate" hreflang="de" href={`${brand.siteUrl}/`} />
          <link rel="alternate" hreflang="en" href={`${brand.siteUrl}/en/`} />
          <link
            rel="alternate"
            hreflang="x-default"
            href={`${brand.siteUrl}/`}
          />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main"
      >{lang === "de" ? "Zum Inhalt springen" : "Skip to content"}</a
    >
    <Header lang={lang} home={home} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
