---
import { brand, type Locale } from "../config/brand";
const { lang = "de", home = false } = Astro.props as {
  lang?: Locale;
  home?: boolean;
};
const en = lang === "en";
const root = en ? "/en/" : "/";
const links = [
  ["services", en ? "Services" : "Leistungen"],
  ["process", en ? "Approach" : "Arbeitsweise"],
  ["portfolio", en ? "Examples" : "Einblicke"],
  ["pricing", en ? "Pricing" : "Preise"],
];
---

<header class="site-header">
  <nav
    class="nav-shell"
    aria-label={en ? "Main navigation" : "Hauptnavigation"}
  >
    <a
      class="brand"
      href={root}
      aria-label={`${brand.descriptor} — ${en ? "Home" : "Startseite"}`}
    >
      <img src={brand.logo} width="40" height="40" alt="" />
    </a>
    <div class="nav-links" id="navigation">
      {links.map(([id, label]) => <a href={`${root}#${id}`}>{label}</a>)}
      <a class="mobile-contact" href={`${root}#contact`}
        >{en ? "Discuss a project" : "Projekt besprechen"} ↗</a
      >
    </div>
    <div class="nav-actions">
      {
        home && (
          <div class="language-switch" aria-label={en ? "Language" : "Sprache"}>
            <a
              href="/"
              lang="de"
              hreflang="de"
              aria-label="Deutsch"
              aria-current={!en ? "page" : undefined}
            >
              DE
            </a>
            <a
              href="/en/"
              lang="en"
              hreflang="en"
              aria-label="English"
              aria-current={en ? "page" : undefined}
            >
              EN
            </a>
          </div>
        )
      }
      <a class="button button-small nav-contact" href={`${root}#contact`}
        >{en ? "Let’s talk" : "Kontakt"} <span aria-hidden="true">↗</span></a
      >
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="navigation"
        aria-label={en ? "Open menu" : "Menü öffnen"}
        data-open={en ? "Open menu" : "Menü öffnen"}
        data-close={en ? "Close menu" : "Menü schließen"}
        ><span></span><span></span></button
      >
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>(".nav-shell");
  const setOpen = (open: boolean, restoreFocus = false) => {
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute(
      "aria-label",
      (open ? toggle.dataset.close : toggle.dataset.open) || "Menu",
    );
    nav?.classList.toggle("is-open", open);
    if (restoreFocus) toggle?.focus();
  };
  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true"),
  );
  nav
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    )
      setOpen(false, true);
  });
  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !nav?.contains(event.target))
      setOpen(false);
  });
  nav?.addEventListener("focusout", (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !nav.contains(event.relatedTarget)
    )
      setOpen(false);
  });
  window
    .matchMedia("(min-width: 960px)")
    .addEventListener("change", () => setOpen(false));
</script>
