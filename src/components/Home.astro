---
import Base from "../layouts/Base.astro";
import ContactForm from "./ContactForm.astro";
import { brand, brandLabel, type Locale } from "../config/brand";
import { homeContent } from "../content/home";
const { lang = "de" } = Astro.props as { lang?: Locale };
const c = homeContent[lang];
---

<Base title={`${c.title} — ${brandLabel}`} lang={lang} home>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="accent-line" aria-hidden="true"></span>{brand.descriptor}
      </p>
      <h1 id="hero-title">{c.hero[0]}<br /><span>{c.hero[1]}</span></h1>
      <p class="hero-intro">{c.intro}</p>
      <div class="hero-actions">
        <a class="button" href="#contact"
          >{c.cta}<span aria-hidden="true">↗</span></a
        ><a class="text-link" href="#services"
          >{c.secondary}<span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-note">{c.reassurance}</p>
    </div>
    <div class="hero-material" aria-hidden="true">
      <div class="material-orbit"></div>
      <img
        class="material-image"
        src="/images/pearl-1600.webp"
        srcset="/images/pearl-800.webp 800w, /images/pearl-1600.webp 1600w"
        sizes="(max-width: 700px) 100vw, 65vw"
        width="1672"
        height="941"
        alt=""
        fetchpriority="high"
      />
      <div class="material-caption">
        <span class="material-cross">+</span><span>{c.materialLabel}</span>
      </div>
    </div>
  </section>
  <div
    class="discipline-bar wrap"
    aria-label={lang === "de"
      ? "Vom Verständnis zur Entscheidung"
      : "From understanding to action"}
  >
    {
      c.disciplines.map((item, index) => (
        <span>
          <b class="mono">0{index + 1}</b>
          {item}
          <span class="discipline-arrow" aria-hidden="true">
            ↗
          </span>
        </span>
      ))
    }
  </div>

  <section class="section wrap" id="problem" aria-labelledby="problem-title">
    <div class="section-heading compact-heading">
      <p class="eyebrow">{c.problemLabel}</p><h2 id="problem-title">
        {c.problemTitle}
      </h2>
    </div>
    <div class="problem-grid">
      {
        c.problems.map(([title, text], index) => (
          <article class="problem-item">
            <>
              <span class="problem-symbol" aria-hidden="true">
                {["↳", "≠", "?"][index]}
              </span>
              <h3>{title}</h3>
              <p>{text}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="section services-section"
    id="services"
    aria-labelledby="services-title"
  >
    <div class="wrap">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">{c.servicesLabel}</p><h2
            class="line-breaks"
            id="services-title"
          >
            {c.servicesTitle}
          </h2>
        </div><p>{c.servicesIntro}</p>
      </div>
      <div class="service-list">
        {
          c.services.map((service, index) => (
            <article class="service-row">
              <div class="service-index mono">
                0{index + 1} <span>{service.tag}</span>
              </div>
              <div class="service-copy">
                <>
                  <h3>{service.title}</h3>
                  <p>{service.text}</p>
                  <ul class="plain-list">
                    {service.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </>
              </div>
              <div class="service-result">
                <>
                  <span class="result-arrow" aria-hidden="true">
                    ↗
                  </span>
                  <p class="eyebrow">{c.resultLabel}</p>
                  <p>{service.result}</p>
                </>
              </div>
            </article>
          ))
        }
      </div>
      <p class="service-note">{c.aiNote}</p>
    </div>
  </section>

  <section class="section wrap" id="process" aria-labelledby="process-title">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">{c.processLabel}</p><h2
          class="line-breaks"
          id="process-title"
        >
          {c.processTitle}
        </h2>
      </div><p>{c.processIntro}</p>
    </div>
    <ol class="process-grid">
      {
        c.steps.map(([title, text, result], index) => (
          <li>
            <>
              <span class="step-number mono">0{index + 1}</span>
              <h3>{title}</h3>
              <p>{text}</p>
              <span class="step-result">{result}</span>
            </>
          </li>
        ))
      }
    </ol>
  </section>

  <section
    class="section portfolio-section"
    id="portfolio"
    aria-labelledby="portfolio-title"
  >
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">{c.portfolioLabel}</p><h2
          class="line-breaks"
          id="portfolio-title"
        >
          {c.portfolioTitle}
        </h2>
      </div>
      <div class="case-grid">
        <figure class="dashboard-figure">
          <a href="/images/cockpit.png" aria-label={c.exampleLink}
            ><img
              src="/images/cockpit.webp"
              width="1250"
              height="703"
              loading="lazy"
              decoding="async"
              alt={c.exampleAlt}
            /><span class="image-expand" aria-hidden="true">↗</span></a
          ><figcaption>{c.exampleCaption}</figcaption>
        </figure>
        <div class="case-copy">
          <p class="eyebrow">{c.exampleTag}</p><h3>{c.exampleTitle}</h3><p>
            {c.exampleText}
          </p><ul class="plain-list">
            {c.exampleBullets.map((text) => <li>{text}</li>)}
          </ul><a class="text-link" href="#contact"
            >{c.cta}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="section wrap"
    id="principles"
    aria-labelledby="principles-title"
  >
    <div class="personal-grid">
      <div>
        <p class="eyebrow">{c.principlesLabel}</p><h2
          class="line-breaks"
          id="principles-title"
        >
          {c.principlesTitle}
        </h2><p class="personal-intro">{c.principlesText}</p>
      </div><div class="principle-list">
        {
          c.principles.map(([title, text], index) => (
            <div>
              <>
                <span class="mono">0{index + 1}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section pricing-section"
    id="pricing"
    aria-labelledby="pricing-title"
  >
    <div class="wrap">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">{c.pricingLabel}</p><h2
            class="line-breaks"
            id="pricing-title"
          >
            {c.pricingTitle}
          </h2>
        </div><p>{c.pricingIntro}</p>
      </div>
      <div class="pricing-grid">
        {
          c.packages.map((pack, index) => (
            <article
              class:list={["price-card", { "price-featured": index === 1 }]}
            >
              <>
                <p class="eyebrow">{pack.name}</p>
                <h3>{pack.subtitle}</h3>
                <div class="price">
                  {pack.price}
                  <span>{pack.unit}</span>
                </div>
                <p class="price-description">{pack.text}</p>
                <ul class="plain-list">
                  {pack.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                <p class="price-limit">{pack.limit}</p>
                <a
                  class:list={["button", { "button-secondary": index !== 1 }]}
                  href={`?package=${pack.value}#contact`}
                  data-package={pack.value}
                >
                  {c.packageCta}
                  <span aria-hidden="true">↗</span>
                </a>
              </>
            </article>
          ))
        }
      </div>
      <p class="price-footnote">{c.priceFootnote}</p>
    </div>
  </section>

  <section
    class="section wrap faq-section"
    id="faq"
    aria-labelledby="faq-title"
  >
    <div>
      <p class="eyebrow">{c.faqLabel}</p><h2 id="faq-title">{c.faqTitle}</h2>
    </div>
    <div class="faq-list">
      {
        c.faqs.map(([question, answer], index) => (
          <details>
            <>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <div class="faq-answer">
                <p>{answer}</p>
                {index === 1 && (
                  <a
                    href="https://www.microsoft.com/en-us/microsoft-fabric/features/power-bi/pricing"
                    class="text-link"
                    rel="external"
                  >
                    {c.sourceLabel} ↗
                  </a>
                )}
              </div>
            </>
          </details>
        ))
      }
    </div>
  </section>

  <section
    class="section contact-section"
    id="contact"
    aria-labelledby="contact-title"
  >
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <p class="eyebrow">{c.contactLabel}</p><h2
          class="line-breaks"
          id="contact-title"
        >
          {c.contactTitle}
        </h2><p class="contact-intro">{c.contactIntro}</p><p
          class="contact-note"
        >
          {c.contactNote}
        </p><div class="contact-direct">
          <span>{c.emailLabel}</span><a href={`mailto:${brand.email}`}
            >{brand.email} <span aria-hidden="true">↗</span></a>
        </div>
      </div><ContactForm lang={lang} />
    </div>
  </section>
</Base>
