---
import Base from "../layouts/Base.astro";
import type { MarkdownInstance } from "astro";
import { brand } from "../config/brand";
const posts = Object.values(
  import.meta.glob<MarkdownInstance<Record<string, any>>>("./blog/*.md", {
    eager: true,
  }),
).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime(),
);
const featured = posts[0];
const date = (value: string) =>
  new Date(value).toLocaleDateString("de-DE", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Base
  title={`Wissen zu Daten & Reporting — ${brand.name}`}
  description="Gedanken und praktische Anleitungen zu Datenqualität, Power BI, Datenmodellen und Reporting für den Mittelstand."
>
  <div class="page-header wrap">
    <p class="eyebrow">JOURNAL / DATEN & ENTSCHEIDUNGEN</p><h1>
      Zusammenhänge verstehen.
    </h1><p>
      Gedanken und praktische Anleitungen zu Datenqualität, Power BI und
      Reporting.
    </p>
  </div>
  <div class="wrap">
    {
      featured && (
        <section class="blog-featured" aria-labelledby="featured-title">
          <>
            <div>
              <>
                <p class="eyebrow">NEUESTER BEITRAG</p>
                <p class="mono">
                  {featured.frontmatter.tag || "Business Intelligence"}
                </p>
              </>
            </div>
            <div>
              <>
                <h2 id="featured-title">
                  <a href={featured.url}>{featured.frontmatter.title}</a>
                </h2>
                <p>{featured.frontmatter.excerpt}</p>
                <div class="post-meta">
                  <time
                    datetime={new Date(featured.frontmatter.date)
                      .toISOString()
                      .slice(0, 10)}
                  >
                    {date(featured.frontmatter.date)}
                  </time>
                  {featured.frontmatter.readTime && (
                    <span>{featured.frontmatter.readTime} Min. Lesezeit</span>
                  )}
                </div>
                <a class="text-link" href={featured.url}>
                  Beitrag lesen <span aria-hidden="true">↗</span>
                </a>
              </>
            </div>
          </>
        </section>
      )
    }
    <section class="blog-list-section" aria-labelledby="all-posts">
      <div class="blog-list-header">
        <h2 id="all-posts">Alle Beiträge</h2><label
          class="blog-search"
          for="blog-search"
          hidden
          >Beiträge durchsuchen<input
            id="blog-search"
            type="search"
            placeholder="Thema oder Begriff"
            autocomplete="off"
          /></label>
      </div><p
        class="blog-results"
        id="blog-results"
        role="status"
        aria-live="polite"
      >
        {posts.length} Beiträge
      </p><div id="post-list">
        {
          posts.map((post) => (
            <a
              class="post-row"
              href={post.url}
              data-search={`${post.frontmatter.title} ${post.frontmatter.tag || ""} ${post.frontmatter.excerpt || ""}`}
            >
              <>
                <span class="mono">{post.frontmatter.tag || "BI"}</span>
                <h3>{post.frontmatter.title}</h3>
                <time
                  datetime={new Date(post.frontmatter.date)
                    .toISOString()
                    .slice(0, 10)}
                >
                  {date(post.frontmatter.date)}
                </time>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          ))
        }
      </div><p id="no-results" class="empty-result" hidden>
        Keine passenden Beiträge. Versuchen Sie einen anderen Begriff.
      </p><nav class="blog-pagination" aria-label="Beitragsseiten" hidden>
        <button id="previous-page" type="button">← Zurück</button><span
          id="page-status"></span><button id="next-page" type="button"
          >Weiter →</button>
      </nav>
    </section>
    <aside class="article-cta">
      <div>
        <h2>Von der Frage zur Umsetzung.</h2><p>
          Besprechen wir, was Ihre Daten im Alltag leisten sollen.
        </p>
      </div><a href="/#contact" class="button"
        >Projekt besprechen <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</Base>
<script>
  const rows = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".post-row"),
  );
  const search = document.querySelector<HTMLInputElement>("#blog-search")!;
  const previous = document.querySelector<HTMLButtonElement>("#previous-page")!;
  const next = document.querySelector<HTMLButtonElement>("#next-page")!;
  const status = document.querySelector<HTMLElement>("#page-status")!;
  const results = document.querySelector<HTMLElement>("#blog-results")!;
  const none = document.querySelector<HTMLElement>("#no-results")!;
  const normalize = (value: string) =>
    value
      .toLocaleLowerCase("de")
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "");
  let page = 1;
  const size = 12;
  const render = () => {
    const query = normalize(search.value.trim());
    const matches = rows.filter((row) =>
      normalize(row.dataset.search || "").includes(query),
    );
    const pages = Math.max(1, Math.ceil(matches.length / size));
    page = Math.max(1, Math.min(page, pages));
    const visible = new Set(matches.slice((page - 1) * size, page * size));
    rows.forEach((row) => {
      row.hidden = !visible.has(row);
    });
    previous.disabled = page === 1;
    next.disabled = page === pages;
    status.textContent = `Seite ${page} von ${pages}`;
    results.textContent = `${matches.length} ${matches.length === 1 ? "Beitrag" : "Beiträge"}`;
    none.hidden = matches.length > 0;
  };
  document.querySelector<HTMLElement>(".blog-search")!.hidden = false;
  document.querySelector<HTMLElement>(".blog-pagination")!.hidden = false;
  search.addEventListener("input", () => {
    page = 1;
    render();
  });
  previous.addEventListener("click", () => {
    page--;
    render();
  });
  next.addEventListener("click", () => {
    page++;
    render();
  });
  render();
</script>
