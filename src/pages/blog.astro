---
import Base from '../layouts/Base.astro';

// Fetch all blog posts, sorted by date
const posts = (await Astro.glob('./blog/*.md')).sort(
  (a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Base title="Blog — Holocron Data" description="Insights zu Power BI, Datenmodellierung und Business Intelligence für den Mittelstand.">
  <div style="padding-top: var(--nav-h);">
    <section style="padding-bottom: 0; border-bottom: 1px solid var(--border);">
      <div class="container">
        <p class="section-label">Blog</p>
        <h1 style="font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 16px;">Insights & Praxis-Tipps</h1>
        <p style="color: var(--text-muted); max-width: 520px; padding-bottom: 48px; font-size: 1.05rem;">
          Praktisches Wissen zu Power BI, Datenmodellierung und Business Intelligence — für den Mittelstand.
        </p>
      </div>
    </section>

    <section>
      <div class="container">
        {posts.length === 0 ? (
          <div style="text-align: center; padding: 80px 0; color: var(--text-muted);">
            <p style="font-family: var(--font-mono); font-size: 13px; margin-bottom: 12px;">// Erste Beiträge erscheinen bald</p>
            <p>Der Blog startet in Kürze.</p>
          </div>
        ) : (
          <div class="blog-grid">
            {posts.map(post => (
              <a href={post.url} class="blog-card" style="text-decoration: none; color: inherit;">
                <div class="blog-card-body">
                  <div class="blog-card-tag">{post.frontmatter.tag || 'Blog'}</div>
                  <div class="blog-card-title">{post.frontmatter.title}</div>
                  <div class="blog-card-excerpt">{post.frontmatter.excerpt}</div>
                  <div class="blog-card-meta">
                    <span>{new Date(post.frontmatter.date).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</span>
                    {post.frontmatter.readTime && <span>· {post.frontmatter.readTime} min</span>}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  </div>
</Base>
