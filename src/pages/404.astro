---
import Base from "../layouts/Base.astro";
import { brandLabel } from "../config/brand";
---

<Base title={`Seite nicht gefunden — ${brandLabel}`} noindex
  ><div class="page-header wrap">
    <p class="eyebrow">404 / SEITE NICHT GEFUNDEN</p><h1>
      Hier geht es nicht weiter.
    </h1><p>
      Die gesuchte Seite ist nicht verfügbar. Auf der Startseite finden Sie
      Leistungen und Kontaktmöglichkeiten.
    </p><p><a class="button" href="/">Zur Startseite ↗</a></p>
  </div></Base
>
