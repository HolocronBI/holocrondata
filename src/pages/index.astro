---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- HERO -->
  <section id="hero" style="padding-top: calc(var(--nav-h) + 80px); padding-bottom: 96px; min-height: 90vh; display: flex; align-items: center;">
    <div class="container">
      <p class="section-label" data-de="Freelance BI Beratung" data-en="Freelance BI Consulting">Freelance BI Beratung</p>
      <h1 style="max-width: 800px; margin-bottom: 24px;">
        <span data-de="Ihre Daten." data-en="Your data.">Ihre Daten.</span><br>
        <span id="shuffle-word" style="color: var(--accent);">Klar.</span>
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-muted); max-width: 560px; margin-bottom: 40px; line-height: 1.7;"
        data-de="Ich helfe mittelständischen Unternehmen, ihre Daten in verlässliche Entscheidungsgrundlagen zu verwandeln — mit Power BI, sauberen Datenmodellen und automatisierten Reports."
        data-en="I help mid-sized companies turn their data into reliable decision-making tools — with Power BI, clean data models and automated reports.">
        Ich helfe mittelständischen Unternehmen, ihre Daten in verlässliche Entscheidungsgrundlagen zu verwandeln — mit Power BI, sauberen Datenmodellen und automatisierten Reports.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="#kontakt" class="btn btn-primary" data-de="Projekt anfragen" data-en="Request project">Projekt anfragen</a>
        <a href="#leistungen" class="btn btn-secondary" data-de="Leistungen ansehen" data-en="View services">Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <!-- LEISTUNGEN -->
  <section id="leistungen" style="background: var(--surface);">
    <div class="container">
      <p class="section-label" data-de="Leistungen" data-en="Services">Leistungen</p>
      <h2 style="margin-bottom: 12px;" data-de="Was ich anbiete" data-en="What I offer">Was ich anbiete</h2>
      <p style="color: var(--text-muted); max-width: 480px; margin-bottom: 48px;"
        data-de="Von der Datenaufnahme bis zum fertigen Dashboard — strukturiert und nachvollziehbar."
        data-en="From data intake to finished dashboard — structured and transparent.">
        Von der Datenaufnahme bis zum fertigen Dashboard — strukturiert und nachvollziehbar.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px;">
        {[
          { icon: '🔍', de_title: 'Daten-Bestandsaufnahme', en_title: 'Data Audit', de_desc: 'Ich analysiere Ihre bestehende Datenlandschaft und identifiziere Lücken, Redundanzen und Potenziale.', en_desc: 'I analyse your existing data landscape and identify gaps, redundancies and opportunities.' },
          { icon: '🧹', de_title: 'Datenbereinigung', en_title: 'Data Cleaning', de_desc: 'Inkonsistente, fehlerhafte oder unvollständige Daten werden bereinigt und für die Weiterverarbeitung vorbereitet.', en_desc: 'Inconsistent, erroneous or incomplete data is cleaned and prepared for further processing.' },
          { icon: '🏗️', de_title: 'Datenmodellierung', en_title: 'Data Modelling', de_desc: 'Aufbau eines stabilen, skalierbaren Datenmodells als Grundlage für verlässliche Analysen.', en_desc: 'Building a stable, scalable data model as the foundation for reliable analyses.' },
          { icon: '📊', de_title: 'Report-Erstellung', en_title: 'Report Creation', de_desc: 'Klare Power BI Dashboards und automatisierte Reports, die Ihre KPIs auf einen Blick sichtbar machen.', en_desc: 'Clear Power BI dashboards and automated reports that make your KPIs visible at a glance.' },
        ].map(s => (
          <div class="card">
            <div style="font-size: 28px; margin-bottom: 16px;">{s.icon}</div>
            <h3 style="margin-bottom: 10px;" data-de={s.de_title} data-en={s.en_title}>{s.de_title}</h3>
            <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6;" data-de={s.de_desc} data-en={s.en_desc}>{s.de_desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ABLAUF -->
  <section id="ablauf">
    <div class="container">
      <p class="section-label" data-de="Ablauf" data-en="Process">Ablauf</p>
      <h2 style="margin-bottom: 48px;" data-de="So arbeiten wir zusammen" data-en="How we work together">So arbeiten wir zusammen</h2>
      <div style="display: flex; flex-direction: column; gap: 0; max-width: 640px;">
        {[
          { num: '01', de_title: 'Erstgespräch', en_title: 'Initial call', de_desc: 'Wir klären Ihre Situation, Ziele und den groben Scope in einem 30-minütigen Call.', en_desc: 'We clarify your situation, goals and rough scope in a 30-minute call.' },
          { num: '02', de_title: 'Analyse & Angebot', en_title: 'Analysis & proposal', de_desc: 'Ich analysiere Ihre Datenquellen und erstelle ein konkretes Angebot mit Zeitplan.', en_desc: 'I analyse your data sources and create a concrete proposal with timeline.' },
          { num: '03', de_title: 'Umsetzung', en_title: 'Implementation', de_desc: 'Wöchentliche Updates, transparente Kommunikation, iterative Lieferung.', en_desc: 'Weekly updates, transparent communication, iterative delivery.' },
          { num: '04', de_title: 'Übergabe', en_title: 'Handover', de_desc: 'Vollständige Dokumentation und Einweisung Ihres Teams — damit Sie unabhängig bleiben.', en_desc: 'Complete documentation and briefing of your team — so you stay independent.' },
        ].map((step, i) => (
          <div style={`display: flex; gap: 24px; padding: 32px 0; ${i < 3 ? 'border-bottom: 1px solid var(--border);' : ''}`}>
            <div style="font-family: var(--font-mono); font-size: 13px; color: var(--accent); font-weight: 500; min-width: 28px; padding-top: 2px;">{step.num}</div>
            <div>
              <h3 style="margin-bottom: 8px;" data-de={step.de_title} data-en={step.en_title}>{step.de_title}</h3>
              <p style="font-size: 14px; color: var(--text-muted);" data-de={step.de_desc} data-en={step.en_desc}>{step.de_desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PREISE -->
  <section id="preise" style="background: var(--surface);">
    <div class="container">
      <p class="section-label" data-de="Preise" data-en="Pricing">Preise</p>
      <h2 style="margin-bottom: 12px;" data-de="Transparente Pakete" data-en="Transparent packages">Transparente Pakete</h2>
      <p style="color: var(--text-muted); margin-bottom: 48px; max-width: 440px;"
        data-de="Feste Preise, klare Leistungen. Kein Stundensatz-Roulette."
        data-en="Fixed prices, clear deliverables. No hourly rate roulette.">
        Feste Preise, klare Leistungen. Kein Stundensatz-Roulette.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; max-width: 900px;">
        {[
          {
            name: 'Insight',
            price: '€ 750',
            de_desc: 'Daten-Bestandsaufnahme & Statusbericht',
            en_desc: 'Data audit & status report',
            items_de: ['Analyse Ihrer Datenquellen', 'Dokumentierter Statusbericht', 'Handlungsempfehlungen', '1 Revisions-Runde'],
            items_en: ['Analysis of your data sources', 'Documented status report', 'Recommendations for action', '1 revision round'],
            pkg: 'insight'
          },
          {
            name: 'Build',
            price: '€ 2.000',
            de_desc: 'Datenmodell + Power BI Dashboard',
            en_desc: 'Data model + Power BI dashboard',
            items_de: ['Datenbereinigung & Modellierung', 'Power BI Dashboard (bis 5 Seiten)', 'Automatisierter Datenrefresh', '2 Revisions-Runden', 'Übergabe & Einweisung'],
            items_en: ['Data cleaning & modelling', 'Power BI dashboard (up to 5 pages)', 'Automated data refresh', '2 revision rounds', 'Handover & briefing'],
            pkg: 'build',
            featured: true
          },
          {
            name: 'Scale',
            price: 'Auf Anfrage',
            de_desc: 'Individuelle BI-Lösung & laufende Betreuung',
            en_desc: 'Custom BI solution & ongoing support',
            items_de: ['Alles aus Build', 'Laufende Betreuung (monatlich)', 'Erweiterte Datenquellen', 'Individuelle Anforderungen'],
            items_en: ['Everything from Build', 'Ongoing support (monthly)', 'Extended data sources', 'Custom requirements'],
            pkg: 'scale'
          },
        ].map(p => (
          <div class="card" style={p.featured ? 'border-color: var(--accent); position: relative;' : ''}>
            {p.featured && <div style="position: absolute; top: -12px; left: 24px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; letter-spacing: 0.04em;" data-de="Beliebt" data-en="Popular">Beliebt</div>}
            <div style="font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">{p.name}</div>
            <div style="font-size: 2rem; font-weight: 700; letter-spacing: -0.03em; margin-bottom: 8px;">{p.price}</div>
            <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--border);" data-de={p.de_desc} data-en={p.en_desc}>{p.de_desc}</p>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px;">
              {p.items_de.map((item, idx) => (
                <li style="font-size: 14px; display: flex; gap: 10px; align-items: flex-start;">
                  <span style="color: var(--accent); margin-top: 1px;">✓</span>
                  <span data-de={item} data-en={p.items_en[idx]}>{item}</span>
                </li>
              ))}
            </ul>
            <a href={`#kontakt`} class="btn btn-primary" style="width: 100%; justify-content: center;"
              data-pkg={p.pkg}
              data-de="Paket anfragen" data-en="Request package">Paket anfragen</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJEKTE -->
  <section id="projekte">
    <div class="container">
      <p class="section-label" data-de="Projekte" data-en="Projects">Projekte</p>
      <h2 style="margin-bottom: 12px;" data-de="Ausgewählte Arbeiten" data-en="Selected work">Ausgewählte Arbeiten</h2>
      <p style="color: var(--text-muted); margin-bottom: 48px;" data-de="Beispielprojekte zur Veranschaulichung der Arbeit." data-en="Example projects to illustrate the work.">Beispielprojekte zur Veranschaulichung der Arbeit.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
        {[
          {
            de_title: 'Vertriebs-Dashboard',
            en_title: 'Sales Dashboard',
            de_tag: 'Power BI · NordTech GmbH',
            en_tag: 'Power BI · NordTech GmbH',
            de_desc: 'Konsolidierung von Verkaufsdaten aus 3 Quellen in ein zentrales Power BI Dashboard mit automatisiertem Monatsabschluss.',
            en_desc: 'Consolidation of sales data from 3 sources into a central Power BI dashboard with automated month-end close.',
            color: '#EFF6FF'
          },
          {
            de_title: 'Datenmodell-Migration',
            en_title: 'Data Model Migration',
            de_tag: 'Datenmodellierung · Mittelstand',
            en_tag: 'Data Modelling · SME',
            de_desc: 'Migration eines gewachsenen Excel-basierten Reportings in ein sauberes Stern-Schema für schnellere Analysen.',
            en_desc: 'Migration of a grown Excel-based reporting system into a clean star schema for faster analyses.',
            color: '#F0FDF4'
          },
          {
            de_title: 'Automatisierter Monatsbericht',
            en_title: 'Automated Monthly Report',
            de_tag: 'Report-Automation · Power BI',
            en_tag: 'Report Automation · Power BI',
            de_desc: 'Vollautomatischer PDF-Export und E-Mail-Versand des Monatsberichts — spart 8 Stunden manuelle Arbeit pro Monat.',
            en_desc: 'Fully automated PDF export and email delivery of monthly report — saves 8 hours of manual work per month.',
            color: '#FFF7ED'
          },
        ].map(proj => (
          <div class="card">
            <div style={`height: 180px; background: ${proj.color}; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: center;`}>
              <canvas width="280" height="140" class="project-canvas" data-type={proj.de_title}></canvas>
            </div>
            <div style="font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-bottom: 10px;" data-de={proj.de_tag} data-en={proj.en_tag}>{proj.de_tag}</div>
            <h3 style="margin-bottom: 8px;" data-de={proj.de_title} data-en={proj.en_title}>{proj.de_title}</h3>
            <p style="font-size: 14px; color: var(--text-muted); line-height: 1.6;" data-de={proj.de_desc} data-en={proj.en_desc}>{proj.de_desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section id="kontakt" style="background: var(--surface);">
    <div class="container" style="max-width: 640px;">
      <p class="section-label" data-de="Kontakt" data-en="Contact">Kontakt</p>
      <h2 style="margin-bottom: 12px;" data-de="Projekt anfragen" data-en="Request a project">Projekt anfragen</h2>
      <p style="color: var(--text-muted); margin-bottom: 40px;" data-de="Beschreiben Sie kurz Ihr Anliegen — ich melde mich innerhalb von 24 Stunden." data-en="Briefly describe your request — I'll get back to you within 24 hours.">Beschreiben Sie kurz Ihr Anliegen — ich melde mich innerhalb von 24 Stunden.</p>

      <form action="https://formspree.io/f/mbdqjadp" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;" data-de="Name" data-en="Name">Name</label>
            <input type="text" name="name" required
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; font-family: var(--font-sans); outline: none; transition: border-color 0.15s;"
              data-de-ph="Max Mustermann" data-en-ph="John Smith" placeholder="Max Mustermann" />
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;">E-Mail</label>
            <input type="email" name="email" required
              style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; font-family: var(--font-sans); outline: none; transition: border-color 0.15s;"
              placeholder="max@firma.de" />
          </div>
        </div>

        <div>
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;" data-de="Paket" data-en="Package">Paket</label>
          <select name="paket" id="paketSelect"
            style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; font-family: var(--font-sans); outline: none; background: var(--bg);">
            <option value="" data-de="Bitte wählen..." data-en="Please select...">Bitte wählen...</option>
            <option value="insight">Insight — € 750</option>
            <option value="build">Build — € 2.000</option>
            <option value="scale" data-de="Scale — Auf Anfrage" data-en="Scale — On request">Scale — Auf Anfrage</option>
            <option value="sonstiges" data-de="Sonstiges" data-en="Other">Sonstiges</option>
          </select>
        </div>

        <div>
          <label style="font-size: 13px; font-weight: 500; display: block; margin-bottom: 6px;" data-de="Nachricht" data-en="Message">Nachricht</label>
          <textarea name="message" rows="5" required
            style="width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; font-family: var(--font-sans); outline: none; resize: vertical; transition: border-color 0.15s;"
            data-de-ph="Kurze Beschreibung Ihres Projekts..." data-en-ph="Brief description of your project..."
            placeholder="Kurze Beschreibung Ihres Projekts..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" style="align-self: flex-start;" data-de="Nachricht senden" data-en="Send message">Nachricht senden</button>
      </form>
    </div>
  </section>
</Base>

<script>
  // Word shuffle animation
  const words = { de: ['Klar.', 'Strukturiert.', 'Verwertbar.', 'Verlässlich.'], en: ['Clear.', 'Structured.', 'Actionable.', 'Reliable.'] };
  let idx = 0;
  let lang = 'de';
  const el = document.getElementById('shuffle-word');
  setInterval(() => {
    idx = (idx + 1) % words.de.length;
    if (el) el.textContent = words[lang as keyof typeof words][idx];
  }, 2000);

  // Package pre-select
  document.querySelectorAll('[data-pkg]').forEach(btn => {
    btn.addEventListener('click', () => {
      const pkg = btn.getAttribute('data-pkg');
      const sel = document.getElementById('paketSelect') as HTMLSelectElement;
      if (sel && pkg) sel.value = pkg;
    });
  });

  // Canvas charts
  document.querySelectorAll('.project-canvas').forEach(canvas => {
    const ctx = (canvas as HTMLCanvasElement).getContext('2d');
    if (!ctx) return;
    const type = canvas.getAttribute('data-type');
    ctx.clearRect(0, 0, 280, 140);

    if (type === 'Vertriebs-Dashboard') {
      const data = [60, 85, 72, 95, 88, 110, 102];
      const max = Math.max(...data);
      const barW = 28, gap = 12, startX = 18;
      data.forEach((v, i) => {
        const h = (v / max) * 90;
        ctx.fillStyle = i === 6 ? '#2563EB' : '#BFDBFE';
        ctx.beginPath();
        ctx.roundRect(startX + i * (barW + gap), 120 - h, barW, h, [4, 4, 0, 0]);
        ctx.fill();
      });
    } else if (type === 'Datenmodell-Migration') {
      const nodes = [[70, 70], [140, 35], [210, 70], [140, 105]];
      ctx.strokeStyle = '#BFDBFE'; ctx.lineWidth = 1.5;
      [[0,1],[0,3],[1,2],[3,2]].forEach(([a,b]) => {
        ctx.beginPath(); ctx.moveTo(nodes[a][0], nodes[a][1]); ctx.lineTo(nodes[b][0], nodes[b][1]); ctx.stroke();
      });
      nodes.forEach(([x, y], i) => {
        ctx.beginPath(); ctx.arc(x, y, i === 0 ? 14 : 9, 0, Math.PI * 2);
        ctx.fillStyle = i === 0 ? '#2563EB' : '#93C5FD'; ctx.fill();
      });
    } else {
      const pts = [20, 55, 40, 35, 80, 50, 120, 25, 160, 40, 200, 20, 240, 30, 260, 22];
      ctx.beginPath(); ctx.moveTo(pts[0], pts[1]);
      for (let i = 2; i < pts.length; i += 2) ctx.lineTo(pts[i], pts[i+1]);
      ctx.strokeStyle = '#2563EB'; ctx.lineWidth = 2.5; ctx.stroke();
      ctx.lineTo(pts[pts.length-2], 130); ctx.lineTo(pts[0], 130); ctx.closePath();
      ctx.fillStyle = 'rgba(37,99,235,0.08)'; ctx.fill();
    }
  });
</script>
